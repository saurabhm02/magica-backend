generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}


enum MessageRole {
  user
  assistant
  system
  tool
}

enum MessageStatus {
  pending
  streaming
  complete
  failed
  cancelled
}

enum RunStatus {
  queued
  running
  waiting
  succeeded
  failed
  cancelled
}

enum ToolStatus {
  pending
  running
  succeeded
  failed
  cancelled
}

enum LedgerType {
  grant
  reserve
  settle
  refund
}

model User {
  id            String         @id @default(cuid())
  clerkUserId   String         @unique
  creditBalance BigInt         @default(30000000)
  createdAt     DateTime       @default(now())
  chats         Chat[]
  runs            AgentRun[]
  ledger          CreditLedger[]
  toolInvocations ToolInvocation[]
}

model Chat {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  title     String     @default("New chat")
  pinned    Boolean    @default(false)
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  messages  Message[]
  runs      AgentRun[]

  @@index([userId, pinned(sort: Desc), updatedAt(sort: Desc), id(sort: Desc)])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Chat_title_trgm_idx")
}

model Message {
  id              String        @id @default(cuid())
  chatId          String
  chat            Chat          @relation(fields: [chatId], references: [id], onDelete: Restrict)
  role            MessageRole
  status          MessageStatus
  content         Json 
  searchText      String?
  clientRequestId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  runsStarted     AgentRun[]    @relation("RunUserMessage")
  runReply        AgentRun?     @relation("RunAssistantMessage")

  @@unique([chatId, clientRequestId])
  @@index([chatId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "Message_searchText_trgm_idx")
}

model AgentRun {
  id                 String    @id @default(cuid())
  chatId             String
  chat               Chat      @relation(fields: [chatId], references: [id], onDelete: Restrict)
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  userMessageId      String 
  userMessage        Message   @relation("RunUserMessage", fields: [userMessageId], references: [id], onDelete: Restrict)
  assistantMessageId String?   @unique
  assistantMessage   Message?  @relation("RunAssistantMessage", fields: [assistantMessageId], references: [id], onDelete: Restrict)
  status             RunStatus @default(queued)
  chargedCredits     BigInt    @default(0)
  idempotencyKey     String    @unique
  triggerRunId       String?   @unique
  routedModel        String?
  usage              Json? 
  error              Json? 
  startedAt          DateTime?
  finishedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  tools              ToolInvocation[]
  skills             RunSkill[]
  ledger             CreditLedger[]

  @@index([chatId, createdAt])
  @@index([userMessageId])
}

model ToolInvocation {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  runId          String?
  run            AgentRun?      @relation(fields: [runId], references: [id], onDelete: Restrict)
  triggerRunId   String?
  toolCallId     String
  order          Int
  toolName       String
  status         ToolStatus     @default(pending)
  input          Json
  output         Json?
  magicaRunId    String?
  credits        BigInt         @default(0)
  durationMs     Int?
  error          Json?
  idempotencyKey String         @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  ledger         CreditLedger[]

  @@unique([runId, toolCallId])
  @@index([runId, order])
  @@index([userId, toolName, createdAt(sort: Desc), id(sort: Desc)])
}

model RunSkill {
  id          String   @id @default(cuid())
  runId       String
  run         AgentRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  skillName   String
  contentHash String
  content     String
  loadedAt    DateTime @default(now())

  @@unique([runId, skillName])
  @@index([runId])
}

model CreditLedger {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  runId            String?
  run              AgentRun?       @relation(fields: [runId], references: [id], onDelete: Restrict)
  toolInvocationId String?
  toolInvocation   ToolInvocation? @relation(fields: [toolInvocationId], references: [id], onDelete: Restrict)
  type             LedgerType
  amount           BigInt
  balanceAfter     BigInt
  idempotencyKey   String          @unique
  createdAt        DateTime        @default(now())

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([runId])
  @@index([toolInvocationId])
}
