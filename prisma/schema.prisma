generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}


enum MessageRole {
  user
  assistant
  system
  tool
}

enum MessageStatus {
  pending
  streaming
  complete
  failed
  cancelled
}

enum RunStatus {
  queued
  running
  waiting
  succeeded
  failed
  cancelled
}

enum ToolStatus {
  pending
  running
  succeeded
  failed
  cancelled
}

enum ToolRunSource {
  ui
  api
}

enum LedgerType {
  grant
  reserve
  settle
  refund
}

enum WaitpointStatus {
  pending
  answered
  skipped
  expired
}

enum AttachmentSource {
  upload
  library
}

enum AttachmentKind {
  image
  video
  audio
}

enum AttachmentStatus {
  ready
  failed
}

model User {
  id            String         @id @default(cuid())
  clerkUserId   String         @unique
  creditBalance BigInt         @default(30000000)
  createdAt     DateTime       @default(now())
  chats         Chat[]
  runs            AgentRun[]
  ledger          CreditLedger[]
  toolInvocations ToolInvocation[]
  attachments     Attachment[]
}

model Chat {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  title     String     @default("New chat")
  pinned    Boolean    @default(false)
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  messages  Message[]
  runs      AgentRun[]

  @@index([userId, pinned(sort: Desc), updatedAt(sort: Desc), id(sort: Desc)])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Chat_title_trgm_idx")
}

model Message {
  id              String        @id @default(cuid())
  chatId          String
  chat            Chat          @relation(fields: [chatId], references: [id], onDelete: Restrict)
  role            MessageRole
  status          MessageStatus
  content         Json 
  searchText      String?
  clientRequestId String?
  suggestion      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  runsStarted     AgentRun[]    @relation("RunUserMessage")
  runReply        AgentRun?     @relation("RunAssistantMessage")
  attachments     Attachment[]

  @@unique([chatId, clientRequestId])
  @@index([chatId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "Message_searchText_trgm_idx")
}

model AgentRun {
  id                 String    @id @default(cuid())
  chatId             String
  chat               Chat      @relation(fields: [chatId], references: [id], onDelete: Restrict)
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  userMessageId      String 
  userMessage        Message   @relation("RunUserMessage", fields: [userMessageId], references: [id], onDelete: Restrict)
  assistantMessageId String?   @unique
  assistantMessage   Message?  @relation("RunAssistantMessage", fields: [assistantMessageId], references: [id], onDelete: Restrict)
  status             RunStatus @default(queued)
  planMode           Boolean   @default(false)
  chargedCredits     BigInt    @default(0)
  idempotencyKey     String    @unique
  triggerRunId       String?   @unique
  routedModel        String?
  usage              Json? 
  error              Json? 
  startedAt           DateTime?
  finishedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  tools               ToolInvocation[]
  skills              RunSkill[]
  ledger              CreditLedger[]
  waitpoints          Waitpoint[]
  webhookSubscription WebhookSubscription?

  @@index([chatId, createdAt])
  @@index([userMessageId])
}

model ToolInvocation {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  runId          String?
  run            AgentRun?      @relation(fields: [runId], references: [id], onDelete: Restrict)
  triggerRunId   String?
  toolCallId     String
  order          Int
  toolName       String
  status         ToolStatus     @default(pending)
  source         ToolRunSource  @default(ui)
  input          Json
  output         Json?
  magicaRunId    String?
  credits        BigInt         @default(0)
  durationMs     Int?
  error          Json?
  idempotencyKey      String               @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  ledger              CreditLedger[]
  waitpoints          Waitpoint[]
  webhookSubscription WebhookSubscription?

  @@unique([runId, toolCallId])
  @@index([runId, order])
  @@index([userId, toolName, createdAt(sort: Desc), id(sort: Desc)])
}

model RunSkill {
  id          String   @id @default(cuid())
  runId       String
  run         AgentRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  skillName   String
  contentHash String
  content     String
  loadedAt    DateTime @default(now())

  @@unique([runId, skillName])
  @@index([runId])
}

model CreditLedger {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  runId            String?
  run              AgentRun?       @relation(fields: [runId], references: [id], onDelete: Restrict)
  toolInvocationId String?
  toolInvocation   ToolInvocation? @relation(fields: [toolInvocationId], references: [id], onDelete: Restrict)
  type             LedgerType
  amount           BigInt
  balanceAfter     BigInt
  idempotencyKey   String          @unique
  createdAt        DateTime        @default(now())

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([runId])
  @@index([toolInvocationId])
}

model Waitpoint {
  id               String          @id @default(cuid())
  runId            String
  run              AgentRun        @relation(fields: [runId], references: [id], onDelete: Restrict)
  toolInvocationId String
  toolInvocation   ToolInvocation  @relation(fields: [toolInvocationId], references: [id], onDelete: Restrict)
  type             String
  tokenId          String          @unique
  status           WaitpointStatus @default(pending)
  payload          Json
  response         Json?
  expiresAt        DateTime
  idempotencyKey   String          @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([runId, status])
  @@index([tokenId])
}

model Attachment {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  messageId  String?
  message    Message?         @relation(fields: [messageId], references: [id], onDelete: Restrict)
  position   Int?
  source     AttachmentSource
  kind       AttachmentKind
  mimeType   String
  sizeBytes  BigInt
  name       String
  url        String
  assemblyId String?
  status     AttachmentStatus @default(ready)
  expiresAt  DateTime?
  createdAt  DateTime         @default(now())

  @@unique([assemblyId, url])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([messageId, position])
}

model WebhookSubscription {
  id               String            @id @default(cuid())
  agentRunId       String?           @unique
  agentRun         AgentRun?         @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  toolInvocationId String?           @unique
  toolInvocation   ToolInvocation?   @relation(fields: [toolInvocationId], references: [id], onDelete: Cascade)
  url              String
  secret           String
  events           String[]          @default([])
  headers          Json?
  metadata         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deliveries       WebhookDelivery[]

  @@index([agentRunId])
  @@index([toolInvocationId])
}

model WebhookDelivery {
  id             String              @id @default(cuid())
  subscriptionId String
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  event          String
  payload        Json
  statusCode     Int?
  attempt        Int                 @default(0)
  status         String              @default("pending")
  error          String?
  idempotencyKey String              @unique
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([subscriptionId])
}
